{
  "netlist": "../testbench-stock-inv.spice",
  "models": {
    "pdk": "ihp-sg13g2",
    "lib": "libs.tech/ngspice/models/cornerMOSlv.lib"
  },
  "corners": {
    "process": ["mos_tt"],
    "supply_v": { "VSUP": [1.2] },
    "temperature_c": [25]
  },
  "analysis": { "kind": "tran", "args": "2p 10n" },
  "measurements": [
    {
      "name": "inv_tpdlh",
      "spice": ".meas tran inv_tpdlh TRIG v(a_ref) VAL=0.6 FALL=1 TARG v(y_ref) VAL=0.6 RISE=1",
      "unit": "s",
      "plausible_range": { "min": 1e-12, "max": 1e-8 }
    },
    {
      "name": "inv_tpdhl",
      "spice": ".meas tran inv_tpdhl TRIG v(a_ref) VAL=0.6 RISE=1 TARG v(y_ref) VAL=0.6 FALL=1",
      "unit": "s",
      "plausible_range": { "min": 1e-12, "max": 1e-8 }
    }
  ],
  "options": {
    "osdi_preload": ["$PDK_ROOT/ihp-sg13g2/libs.tech/ngspice/osdi/psp103.osdi"],
    "keep_artifacts": false
  }
}
